rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if true;

      match /financial/{docId} {
        allow read, write: if true;
      }

      match /expenses/{expenseId} {
        allow read, write: if true;
      }
    }

    match /users_by_email/{emailHash} {
      allow read, write: if true;
    }
  }
}
